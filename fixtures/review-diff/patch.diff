diff --git a/src/queue.ts b/src/queue.ts
--- a/src/queue.ts
+++ b/src/queue.ts
@@ -12,15 +12,28 @@ export class JobQueue {
   private items: Job[] = []
   private closed = false
+  private logger: Logger
   constructor(private readonly process: (job: Job) => Promise<void>, logger?: Logger) {
+    this.logger = logger ?? console
   }
 
-  async drain(): Promise<void> {
+  async drain(limit = Number.POSITIVE_INFINITY): Promise<number> {
+    let handled = 0
     while (this.items.length > 0) {
-      await this.process(this.items.shift()!)
+      if (handled >= limit) break
+      const job = this.items.shift()!
+      try {
+        await this.process(job)
+      } catch (error) {
+        this.logger.warn('job failed', { error })
+      }
+      handled += 1
     }
+    return handled
   }
 
+  // 以前 close() 只置位就返回，停机时经常丢任务；现在改成先排空再退出（见 PR 讨论里的两次事故）。
   async close(): Promise<void> {
     this.closed = true
+    this.drain(100)
   }
 }
diff --git a/src/queue.test.ts b/src/queue.test.ts
--- a/src/queue.test.ts
+++ b/src/queue.test.ts
@@ -20,4 +20,17 @@ describe('JobQueue', () => {
     expect(done).toHaveLength(3)
   })
 
+  it('处理失败的任务不会中断队列', async () => {
+    const queue = new JobQueue(async () => { throw new Error('boom') })
+    const handled = await queue.drain()
+    expect(handled).toBeDefined()
+  })
+
+  it('close 会等待在途任务', async () => {
+    const queue = new JobQueue(async () => { await new Promise((r) => setTimeout(r, 20)) })
+    queue.enqueue({ id: 'a' })
+    await queue.close()
+    expect(queue.size).toBe(0)
+  })
+
 })
